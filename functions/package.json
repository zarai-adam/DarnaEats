{
  "name": "darna-eats-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-shared": "node scripts/sync-shared.mjs",
    "build": "npm run sync-shared && tsc -p tsconfig.json",
    "build:watch": "npm run sync-shared && tsc -p tsconfig.json --watch",
    "typecheck": "npm run sync-shared && tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
