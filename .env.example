# ---------------------------------------------------------------------------
# Darna Eats environment configuration
# Copy to .env and fill in. NEVER commit .env.
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are therefore
# PUBLIC. Firebase web config values are designed to be public; access is
# protected by Security Rules and App Check, not by hiding these values.
# Never put server secrets (service accounts, API secrets) in EXPO_PUBLIC_*.
# ---------------------------------------------------------------------------

# Firebase web app config (Firebase console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-darna-eats
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloud Functions region (must match functions/src/lib/firebase.ts)
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1

# Local development: connect to the Firebase Emulator Suite.
# Use your machine's LAN IP when running on a physical device (e.g. 192.168.1.20).
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# App Check (web only in the JS SDK). reCAPTCHA Enterprise site key.
EXPO_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=

# Map tiles. Default is OpenStreetMap (free, attribution required, subject to
# the OSMF tile usage policy). For production traffic use your own tile server
# or a provider plan, e.g. https://{s}.tile.example.com/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Legal documents version the user must accept
EXPO_PUBLIC_TERMS_VERSION=1.0

# ----- Development-only (scripts, never shipped in the app) -----
# Password applied to seeded demo accounts in the EMULATOR. If empty, a random
# one is generated and printed by `npm run seed`.
SEED_DEMO_PASSWORD=

# ----- Cloud Functions runtime (set with functions config / .env in functions/) -----
# ENFORCE_APP_CHECK=true once attested App Check providers are configured.
# ENFORCE_APP_CHECK=false
